  "biography": {
    "plain_text": "Costakis Loizou is the Cypriot chairman and controlling shareholder of Louis Group, the tourism business established by his father. Based in Nicosia, he studied economics and business in London and Geneva before expanding the family enterprise across hotels and cruises. Its hotel operations extend through Cyprus and the Greek islands.",
    "html": "<p>Costakis Loizou is the Cypriot chairman and controlling shareholder of Louis Group, the tourism business established by his father. Based in Nicosia, he studied economics and business in London and Geneva before expanding the family enterprise across hotels and cruises. Its hotel operations extend through Cyprus and the Greek islands.</p>\r\n",
    "word_count": 50,
    "confidence": {
      "score": 91,
