  "biography": {
    "plain_text": "Darius Krasauskas is a Lithuanian businessman with a controlling stake in Blancomet Recycling UK. The company collects and processes secondary raw materials, including catalytic converters, electronic waste and batteries. Its recycling operations recover valuable metals for reuse, serving suppliers through a network of facilities across the United Kingdom and Ireland.",
    "confidence": {
      "score": 95,
