  "biography": {
    "plain_text": "Robert Brockman was an American software entrepreneur who founded Universal Computer Services to serve car dealerships. A University of Florida business graduate and former Ford and IBM employee, he expanded the company internationally. Its acquisition of Reynolds and Reynolds made him chairman and chief executive of the combined dealership-software business.",
    "confidence": {
      "score": 97,
