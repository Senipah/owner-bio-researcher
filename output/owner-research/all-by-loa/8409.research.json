  "biography": {
    "plain_text": "Seymour Marvin was a Brazilian industrialist and amateur golf champion, born in New York and raised in Rio de Janeiro. A Princeton graduate and wartime US Navy volunteer, he joined his father's paint business after returning to Brazil. He won the national amateur title and later became a naturalised Brazilian citizen.",
    "html": "<p>Seymour Marvin was a Brazilian industrialist and amateur golf champion, born in New York and raised in Rio de Janeiro. A Princeton graduate and wartime US Navy volunteer, he joined his father's paint business after returning to Brazil. He won the national amateur title and later became a naturalised Brazilian citizen.</p>\r\n",
    "word_count": 51,
    "confidence": {
      "score": 88,
      "band": "high",
      "reason": "Institutional history and independent career evidence support the selected facts."
    },
