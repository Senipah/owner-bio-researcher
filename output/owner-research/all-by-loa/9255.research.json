  "biography": {
    "plain_text": "Scott Burke is an American physician and entrepreneur who founded Injury Finance, a Colorado business funding medical treatment associated with personal-injury claims. A Pennsylvania State University medical graduate, he also owned Denver Spine and Rehabilitation. His financing company grew into a national platform before merging with Omni Healthcare at the end of 2021.",
    "html": "<p>Scott Burke is an American physician and entrepreneur who founded Injury Finance, a Colorado business funding medical treatment associated with personal-injury claims. A Pennsylvania State University medical graduate, he also owned Denver Spine and Rehabilitation. His financing company grew into a national platform before merging with Omni Healthcare at the end of 2021.</p>\r\n",
    "word_count": 53,
