  "biography": {
    "plain_text": "Roberto Rotondo Mendoza is a Peruvian businessman and former minister of industry and tourism. Born in Callao, he studied economics and accountancy at the Pontifical Catholic University of Peru. He founded Jungle Xports, an Amazon river tourism business, after serving in Fernando Belaúnde Terry’s government during its return to civilian rule.",
    "html": "<p>Roberto Rotondo Mendoza is a Peruvian businessman and former minister of industry and tourism. Born in Callao, he studied economics and accountancy at the Pontifical Catholic University of Peru. He founded Jungle Xports, an Amazon river tourism business, after serving in Fernando Belaúnde Terry’s government during its return to civilian rule.</p>\r\n",
    "word_count": 51,
    "confidence": {
      "score": 81,
      "band": "medium",
      "reason": "Bounded historical facts match full relevant primary sections and independently described company ownership."
    },
