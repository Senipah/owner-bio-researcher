  "biography": {
    "plain_text": "Dieter Zetsche is a German engineer and former chief executive of Daimler. He joined the company’s research department after studying electrical engineering, then held management posts in Brazil, Argentina and the United States. After leading Mercedes-Benz, he became chairman of tourism group TUI’s supervisory board and chaired African Parks Foundation Germany.",
    "confidence": {
      "score": 97,
      "band": "very_high",
      "reason": "Primary employer and foundation biographies establish the career and separate governance positions."
    },
    "source_ids": [
      "S1",
