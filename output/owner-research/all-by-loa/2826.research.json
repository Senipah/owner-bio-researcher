  "biography": {
    "plain_text": "Jack Nicklaus, known as the Golden Bear, is an American golfer who won a record eighteen professional major championships. He built a second career designing golf courses and developing businesses around his name, from branded products to international licensing. His family participates in the enterprise he established alongside his playing career.",
    "confidence": {
      "score": 96,
      "band": "very_high",
      "reason": "Official career records, business descriptions and current family-management evidence converge."
    },
    "source_ids": [
      "S1",
