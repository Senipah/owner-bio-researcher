  "biography": {
    "plain_text": "Melvin Simon was an American property developer who built a billionaire fortune through shopping centres. Born in Brooklyn, he settled in Indianapolis after Army service and worked as a leasing agent. With his brothers, he founded the business that became Simon Property Group, helping expand enclosed malls across the United States.",
    "confidence": {
      "score": 87,
