  "biography": {
    "plain_text": "Barbara Peterson Burwell is an American philanthropist and former Miss USA who became Minnesota's first national titleholder in 1976. A St. Olaf graduate and daughter of a state Supreme Court justice, she later led the Rodney and Barbara Burwell Family Foundation, supporting educational and charitable institutions alongside her husband and sons.",
    "confidence": {
      "score": 93,
      "band": "high",
      "reason": "Reference biography, specialist pageant results and primary institutional sources establish the public career and family philanthropy."
    },
    "source_ids": [
