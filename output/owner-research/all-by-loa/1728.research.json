  "biography": {
    "plain_text": "Charles M. Pigott was an American industrialist who led PACCAR, the truck manufacturer established by his grandfather. A Stanford-trained engineer and former naval pilot, he developed the family business into an international producer of Kenworth and Peterbilt trucks. His career combined substantial company ownership with three decades of leadership before retiring in 1997.",
    "confidence": {
      "score": 92,
      "band": "high",
      "reason": "Family obituary, business-school profile and SEC ownership record support the identity, formation and economic interest."
    },
    "source_ids": [
