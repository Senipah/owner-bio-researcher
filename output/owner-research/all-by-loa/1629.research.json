  "biography": {
    "plain_text": "Christina Onassis was a Greek shipping heiress and businesswoman, born in New York to Aristotle Onassis and Athina Livanos. She inherited a substantial share of her father's shipping fortune and became the first woman elected to the Union of Greek Shipowners' board. Her daughter, Athina, succeeded to her private estate.",
    "confidence": {
      "score": 95,
      "band": "very_high",
      "reason": "Contemporary obituary and biographical reference support background, inheritance, industry board milestone and succession."
    },
    "source_ids": [
