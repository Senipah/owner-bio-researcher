  "biography": {
    "plain_text": "The John N. Calley Foundation is a California private foundation that supports educational opportunities for talented young people whose abilities may go unrecognised. It honours the legacy of film executive and producer John Calley, whose career was marked by backing creative talent. Its grantmaking supports youth-serving organisations and emerging leaders.",
    "confidence": {
      "score": 96,
