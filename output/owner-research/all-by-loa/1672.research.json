  "biography": {
    "plain_text": "Ralph Parsons was an American engineer who founded a major international construction and engineering company in Los Angeles. The son of a Long Island fisherman, he trained in machine design and served in the Navy before entering industry. His company built refineries, industrial plants and infrastructure, creating the fortune behind his charitable foundation.",
    "confidence": {
      "score": 97,
      "band": "very_high",
      "reason": "Foundation and company history corroborate family, training, service and founding; court and securities records substantiate business ownership and services."
    },
    "source_ids": [
