  "biography": {
    "plain_text": "Gina van Asbeck is a Dutch property executive, also known as Gesina van Hoeven. The widow of developer Carel van Asbeck, she took over management roles in his business network. She represented the owners in plans to redevelop the Honig factory in Koog aan de Zaan and managed French property companies.",
    "confidence": {
      "score": 86,
      "band": "high",
      "reason": "Legal identity and succession records corroborate the development representative; occupation does not imply personal ownership."
    },
    "source_ids": [
