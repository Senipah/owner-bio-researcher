  "biography": {
    "plain_text": "Anthony Ramsden is a British racehorse owner who established Valmont with bloodstock agent Alex Elliott. Educated at Harrow, he is the son of trainer Lynda Ramsden and gambler Jack Ramsden. He also controls AJR Investments, and his racing interests have included horses owned jointly with Newsells Park Stud and sent to trainer Ralph Beckett.",
    "html": "<p>Anthony Ramsden is a British racehorse owner who established Valmont with bloodstock agent Alex Elliott. Educated at Harrow, he is the son of trainer Lynda Ramsden and gambler Jack Ramsden. He also controls AJR Investments, and his racing interests have included horses owned jointly with Newsells Park Stud and sent to trainer Ralph Beckett.</p>\r\n",
    "word_count": 54,
    "confidence": {
      "score": 95,
      "band": "very_high",
      "reason": "Direct company records and interviews with his agent and partner support the distinct factual allocations."
    },
